{
  "extends": "@foxglove/tsconfig/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false
  },
  "include": [
    ".storybook/main.ts",
    "ci/**/*.ts",
    "ci/**/*.mts",
    "*.ts",
    "*.mts",
    "package.json"
  ]
}
