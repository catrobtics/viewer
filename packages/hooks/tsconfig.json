{
  "extends": "@foxglove/tsconfig/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "es2022"],
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vitest/globals", "vite/client"],
    "outDir": "./dist",
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false
  },
  "include": ["./src/**/*"]
}
